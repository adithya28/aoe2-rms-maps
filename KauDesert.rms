/* =================================================================================================== */
<PLAYER_SETUP>

behavior_version 2
random_placement

/* custom forest mix */
effect_amount GAIA_UPGRADE_UNIT OAKTREE DLC_DEADTREE 0
effect_amount GAIA_UPGRADE_UNIT BUSH_A ITALIAN_PINETREE 0

/* make rubble last longer - 12 is the default and is 1 min ingame */
effect_amount GAIA_SET_ATTRIBUTE RUBBLE_CIRCLE_1 ATTR_STORAGE_VALUE 30000

effect_amount GAIA_SET_ATTRIBUTE RUBBLE_1X1 ATTR_STORAGE_VALUE rnd(500,600)
effect_amount GAIA_SET_ATTRIBUTE RUBBLE_2X2 ATTR_STORAGE_VALUE rnd(600,700)
effect_amount GAIA_SET_ATTRIBUTE HOUSE_C_RUBBLE ATTR_STORAGE_VALUE rnd(700,800)
effect_amount GAIA_SET_ATTRIBUTE BARRACKS_C_RUBBLE ATTR_STORAGE_VALUE rnd(800,900)
effect_amount GAIA_SET_ATTRIBUTE STABLE_C_RUBBLE ATTR_STORAGE_VALUE rnd(800,900)
effect_amount GAIA_SET_ATTRIBUTE BLACKSMITH_C_RUBBLEE ATTR_STORAGE_VALUE rnd(800,900)
effect_amount GAIA_SET_ATTRIBUTE MARKET_C_RUBBLE ATTR_STORAGE_VALUE rnd(800,900)
effect_amount GAIA_SET_ATTRIBUTE FORTRESS_RUBBLE ATTR_STORAGE_VALUE rnd(900,1000)

/* visibility behind the ruins */
effect_amount GAIA_SET_ATTRIBUTE RUINED_CASTLE ATTR_OCCLUSION_MODE 2
effect_amount GAIA_SET_ATTRIBUTE RUINED_CHAPEL ATTR_OCCLUSION_MODE 2
effect_amount GAIA_SET_ATTRIBUTE ROCK ATTR_OCCLUSION_MODE 2
effect_amount GAIA_SET_ATTRIBUTE ROCK2 ATTR_OCCLUSION_MODE 2

/* =================================================================================================== */
<LAND_GENERATION>

base_terrain WET_GRAVEL

create_player_lands {
	terrain_type WET_GRAVEL
	base_size 12
	land_percent 100
	circle_radius 35 0
	if TINY_MAP
		left_border 8
		right_border 9
		top_border 8
		bottom_border 9
	elseif SMALL_MAP
		left_border 7
		right_border 8
		top_border 7
		bottom_border 8
	elseif MEDIUM_MAP
		left_border 6
		right_border 7
		top_border 6
		bottom_border 7
	elseif LARGE_MAP
		left_border 5
		right_border 6
		top_border 5
		bottom_border 6
	else
		left_border 5
		right_border 5
		top_border 5
		bottom_border 5
	endif
	base_elevation 1
}

create_land {
	terrain_type DLC_BLACK
	base_size 3
	land_percent 100
	land_position 50 50
	left_border 45	right_border 45	top_border 45	bottom_border 45
	land_id 1
	base_elevation 16
}


/* =================================================================================================== */
<ELEVATION_GENERATION> 
/* required for base_elevation to work */


