/* =================================================================================================== */
<CONNECTION_GENERATION>

create_connect_to_nonplayer_land {
	replace_terrain DRY_GRAVEL LAVA
	replace_terrain WET_GRAVEL LAVA
	replace_terrain DLC_ROCK LAVA
	replace_terrain OAK_BUSH_FOREST LAVA
	replace_terrain MUD LAVA
	replace_terrain DLC_DESERTGRAVEL ROAD2
	
	terrain_size DLC_ROCK 1 0
	terrain_size WET_GRAVEL 2 0
	terrain_size DRY_GRAVEL 2 1
}


