	#const BIRD_A 917
	#const BIRD_B 1028
	#const SHRUB 123
	#const WILD_HORSE 1356 /* Wild Horse */

endif


<PLAYER_SETUP>
	random_placement

	#define PRELIMINARIES
	if PRELIMINARIES
		behavior_version 1
	
		/* Correcting terrain restrictions for deer so they may also generate on beaches. */
		/* Also making zebra/deer food smaller */
		effect_amount SET_ATTRIBUTE DEER ATTR_TERRAIN_ID 7
		effect_amount SET_ATTRIBUTE STONE ATTR_TERRAIN_ID 7
		effect_amount GAIA_ADD_ATTRIBUTE DEER ATTR_STORAGE_VALUE -40
		/* Make box turtle food smaller */
		effect_amount GAIA_ADD_ATTRIBUTE BOX_TURTLE ATTR_STORAGE_VALUE -75
		

		/* Setting terrain restrictions on various aesthetic objects, so they may not generate in the water. */
		effect_amount SET_ATTRIBUTE PH_BLOCK ATTR_DEAD_ID -1
		effect_amount SET_ATTRIBUTE PH_BLOCK ATTR_TERRAIN_ID 0
		effect_amount SET_ATTRIBUTE PH_BLOCK ATTR_LINE_OF_SIGHT 0
		effect_amount SET_ATTRIBUTE PH_BLOCK ATTR_HITPOINTS 0
		effect_amount SET_ATTRIBUTE PH_BLOCK ATTR_STORAGE_VALUE 0
				
		/* TODO change tree wood and lizard food */
		effect_amount GAIA_ADD_ATTRIBUTE KOMODO ATTR_STORAGE_VALUE 60
		effect_amount GAIA_ADD_ATTRIBUTE KOMODO ATTR_ATTACK 1026 /* this should increase attack by 2 */
		effect_amount GAIA_ADD_ATTRIBUTE MANGROVE_TREE ATTR_STORAGE_VALUE 150

	endif


<LAND_GENERATION>
base_terrain BASE_TERRAIN


create_player_lands
{
	terrain_type SPAWN_TERRAIN
	if MAPSIZE_TINY
	base_size 8
	land_percent 5
	else
	base_size 8
	land_percent 6
	endif
	clumping_factor 20
	if MAPSIZE_TINY
	circle_radius 22
	else
	circle_radius 23
	endif
	base_elevation 2
	zone 2
}

create_land
{
	terrain_type WATER
	if MAPSIZE_TINY
	number_of_tiles 120
	base_size 4
	else
	number_of_tiles 200
	base_size 3
	endif
	clumping_factor 25
	base_elevation 0
	land_position 50 50
	
/*	min_placement_distance 29 */
}


