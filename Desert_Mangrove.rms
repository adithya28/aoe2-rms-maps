	#const PH_PLAYER_OFF 647 /* Off-Grid Object - only used for player objects */

	#const SHRUB_1 1362
	#const SHRUB_2 1363
	#const ROCK_A 1048
	#const ROCK_B 1049
	#const ROCK_C 1050
	#const BAOBAB 1052
	
	#const MANGROVE_TREE 1144
